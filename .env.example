# LVO Security — local environment
# Copy this file to `.env` and fill in real values before running locally.

# PostgreSQL connection string (required)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lab_command_center

# Port the API + dashboard listen on
PORT=3000

# Base path used by the frontend build (keep as "/" for the default)
BASE_PATH=/

# Platform owner account (the person running the platform), created/updated on
# every server start. This is the account that signs in at /admin.
# PASSWORD must be at least 6 characters. Leave both unset to skip bootstrap.
PLATFORM_ADMIN_USERNAME=admin
PLATFORM_ADMIN_PASSWORD=change-me

# development | production
NODE_ENV=development

# --- WAF-lite (all optional; WAF is bootstrap-on, extra layers off) ---

# Comma-separated country allowlist, enforced ONLY when set. Requests from
# other countries are blocked (403) when WAF_ENFORCE is on; when WAF_ENFORCE=off
# they are only logged behind Cloudflare's address. The CF-IPCountry header is
# trusted only when Cloudflare is provably in front. Examples: "KE,US,GB".
# WAF_ALLOW_COUNTRIES=

# Set to "off" to run the WAF in observe mode (log-only). Anything else
# (default) enforces the WAF rules. Migration order lives in
# docs/CLOUDFLARE-EDGE.md.
# WAF_ENFORCE=off
